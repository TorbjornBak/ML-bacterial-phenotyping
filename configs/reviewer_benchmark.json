  "n_folds": 5,
  "split_seed": 20260901,
  "clustering": {
    "ksize": 31,
    "n_hashes": 1000,
    "min_similarity": 0.96
  },
  "normalization": "frequency",
  "reverse_complement": false,
  "model": {
    "solver": "liblinear",
    "class_weight": "balanced",
    "C": 1.0,
    "max_iter": 2000,
    "random_state": 20260901
  },
  "output_dir": "results/reviewer_benchmark_jaccard_096"
