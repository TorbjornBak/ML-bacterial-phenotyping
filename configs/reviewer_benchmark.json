{
  "notes": "Example paths match the checked-in metadata. Dataset 1 genome parquet files are distributed separately; place them under data/dataset_1 before running.",
  "datasets": {
    "gentamicin": {
      "input": "data/dataset_2/genomes",
      "labels": "data/dataset_2/metadata_ecoli_gentamicin.csv",
      "file_type": "fasta",
      "id_column": "genome_id",
      "sequence_column": "dna_sequence",
      "label_separator": ","
